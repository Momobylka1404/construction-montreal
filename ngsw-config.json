{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/expertises/index.html",
          "/realisations/index.html",
          "/pourquoi-nous/index.html",
          "/avis/index.html",
          "/faq/index.html",
          "/contact/index.html",
          "/en/index.html",
          "/en/expertises/index.html",
          "/en/realisations/index.html",
          "/en/pourquoi-nous/index.html",
          "/en/avis/index.html",
          "/en/faq/index.html",
          "/en/contact/index.html",
          "/manifest.webmanifest",
          "/images/hero-montreal.webp",
          "/icons/apple-touch-icon.png",
          "/icons/icon-192x192.png",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "media-assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/images/**/*.(webp|jpg|jpeg|png|avif|svg)",
          "/icons/**/*.(png|svg)"
        ]
      }
    },
    {
      "name": "fonts-and-misc",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(cur|apng|gif|otf|ttf|woff|woff2)"]
      }
    }
  ]
}
