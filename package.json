{
  "name": "construction-montreal",
  "version": "1.0.0",
  "description": "180 Services à domicile — Site web bilingue (FR/EN), SSR pré-rendu et PWA (Montréal)",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "node scripts/build-pages.mjs",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "verify:seo": "node scripts/verify-seo.mjs",
    "check": "npm run typecheck && npm run test:ci",
    "set-domain": "node scripts/set-domain.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\"",
    "serve:ssr:construction-montreal": "node dist/construction-montreal/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@angular/ssr": "^22.2.7",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
